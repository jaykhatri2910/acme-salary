# Environment variables for ACME Salary Management Backend
# Copy this file to .env and fill in the values for your environment.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Database ──────────────────────────────────────────────────────────────────
# Connection string format: postgres://user:password@host:port/database
DATABASE_URL=postgres://postgres:password@localhost:5432/acme_salary

# Used by Jest integration tests — should point to a separate test database
TEST_DATABASE_URL=postgres://postgres:password@localhost:5432/acme_salary_test

# JWT
JWT_SECRET=your_jwt_secret_minimum_8_chars_long
